# ─────────────────────────────────────────────────────────────────
# Incident Triage & Alert Routing — Environment Variables
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then load it before running:
#   source .env          (Linux / macOS)
#   set -a; . .env; set +a   (bash alternative)
#   # On Windows: set each variable manually in Command Prompt
# ─────────────────────────────────────────────────────────────────

# ── LLM API endpoint (required for LLM agent mode) ───────────────
# Hugging Face inference router (recommended):
API_BASE_URL=https://router.huggingface.co/v1

# Alternatives:
# API_BASE_URL=https://api.openai.com/v1          # OpenAI directly
# API_BASE_URL=http://localhost:11434/v1          # Ollama local

# ── Model name ────────────────────────────────────────────────────
# Must be a model available at the above API endpoint
MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct

# Other options:
# MODEL_NAME=gpt-4o-mini                          # OpenAI
# MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3  # HF
# MODEL_NAME=llama3.2                             # Ollama

# ── Authentication token ──────────────────────────────────────────
# Your Hugging Face token (get it at https://huggingface.co/settings/tokens)
# Required for HF inference router. For OpenAI use your OpenAI API key.
HF_TOKEN=hf_your_token_here

# ─────────────────────────────────────────────────────────────────
# NOTE: The Streamlit UI works without any API keys set.
# It will automatically fall back to the rule-based agent.
# API keys are only needed for the LLM Agent mode in the UI
# or when running inference.py directly.
# ─────────────────────────────────────────────────────────────────
